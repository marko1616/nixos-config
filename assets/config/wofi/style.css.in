* {
    font-family: monospace;
    font-size: 12pt;
    border: none;
    border-radius: 0;
    outline: none;
    box-shadow: none;
    text-shadow: none;
    background-image: none;
}

#window {
    background-color: @windowBackground@;
    color: @windowText@;
    border: 1px solid @windowBorder@;
    border-radius: 10px;
}

#outer-box {
    padding: 8px 40px;
}

#input {
    margin: 0;
    padding: 0;
    min-height: 28px;
    background-color: @inputBackground@;
    color: @inputText@;
    caret-color: @inputCaret@;
}

#input selection {
    background-color: @inputSelectionBackground@;
    color: @inputSelectionText@;
}

#scroll {
    margin: 0;
    padding: 0;
    background-color: @scrollBackground@;
}

#inner-box {
    margin: 0;
    padding: 0;
    background-color: @innerBoxBackground@;
}

#entry {
    padding: 2px 0;
    background-color: @entryBackground@;
    color: @entryText@;
}

#entry:selected {
    background-color: @selectedEntryBackground@;
    color: @selectedEntryText@;
}

#text {
    margin: 0;
    color: @labelText@;
}

#entry:selected #text {
    color: @selectedLabelText@;
}

#img {
    margin-right: 8px;
}
