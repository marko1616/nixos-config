[Metadata]
Name=Marko Shell
Version=1
Description=Tokyo Night candidate panel matching marko-shell

[InputPanel]
NormalColor=@normalText@
HighlightColor=@highlightText@
HighlightBackgroundColor=@highlightBackground@
HighlightCandidateColor=@highlightCandidateText@
CandidateLabelColor=@candidateLabel@
HighlightCandidateLabelColor=@highlightCandidateLabel@
CandidateCommentColor=@candidateComment@
HighlightCandidateCommentColor=@highlightCandidateComment@

[InputPanel/Background]
Image=panel.svg

[InputPanel/Background/Margin]
Left=10
Right=10
Top=10
Bottom=10

[InputPanel/Highlight]
Image=highlight.svg

[InputPanel/Highlight/Margin]
Left=10
Right=10
Top=10
Bottom=10

[InputPanel/ContentMargin]
Left=12
Right=12
Top=12
Bottom=12

[InputPanel/TextMargin]
Left=9
Right=9
Top=6
Bottom=6
