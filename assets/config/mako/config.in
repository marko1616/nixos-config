anchor=top-right
margin=10

width=400
height=150

padding=12
border-size=1
border-radius=10

background-color=@defaultBackground@
text-color=@defaultText@
border-color=@defaultBorder@

font=Terminess Nerd Font 14

default-timeout=5000
ignore-timeout=0

icons=1
max-icon-size=48
max-visible=5

markup=1

[urgency=low]
background-color=@lowBackground@
text-color=@lowText@
border-color=@lowBorder@
default-timeout=5000

[urgency=normal]
background-color=@normalBackground@
text-color=@normalText@
border-color=@normalBorder@
default-timeout=5000

[urgency=critical]
background-color=@criticalBackground@
text-color=@criticalText@
border-color=@criticalBorder@
default-timeout=0
